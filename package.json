{
  "name": "teamboard-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Teamboard: a small Kanban board used as the demo workload for developer-environment comparisons.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --prefix-colors auto \"npm:dev:*\"",
    "dev:api": "npm run dev -w @teamboard/api",
    "dev:web": "npm run dev -w @teamboard/web",
    "db:migrate": "npm run migrate -w @teamboard/db",
    "db:seed": "npm run seed -w @teamboard/db",
    "db:setup": "npm run setup -w @teamboard/db",
    "db:reset": "npm run reset -w @teamboard/db",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @teamboard/web",
    "test:ui": "npm run test:ui -w @teamboard/web",
    "storybook": "npm run storybook -w @teamboard/web",
    "build-storybook": "npm run build-storybook -w @teamboard/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
