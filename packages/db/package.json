{
  "name": "@teamboard/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Teamboard database package: migrations, typed queries, seed data and shared types.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schemas": "./src/schemas.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "setup": "tsx src/cli/setup.ts",
    "reset": "tsx src/cli/reset.ts",
    "seed-storybook": "tsx src/cli/seed-storybook.ts",
    "reset-storybook": "tsx src/cli/seed-storybook.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
