{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@teamboard/api"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug web in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web"
    },
    {
      "name": "Debug unit tests (vitest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["test", "-w", "@teamboard/web"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + web",
      "configurations": ["Debug API", "Debug web in Chrome"],
      "stopAll": true
    }
  ]
}
